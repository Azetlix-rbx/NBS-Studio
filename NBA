  Globals luaGlobals(){Globals g=JsePlatform.standardGlobals();for(String n:new String[]{"os","io","luajava","require","dofile","loadfile"})g.set(n,LuaValue.NIL);return g;}
  ArrayList<Pr> full(String s){ArrayList<Pr> P=lint(lex(s));boolean bad=false;for(Pr p:P)if(!p.warn)bad=true;
    if(!bad){try{if(chk==null)chk=luaGlobals();chk.load(s,"script");}
      catch(LuaError e){String m=String.valueOf(e.getMessage());Matcher x=Pattern.compile("script:(\\d+):?\\s*(.*)",Pattern.DOTALL).matcher(m);
        if(x.find())add(P,Integer.parseInt(x.group(1)),"Синтаксис Lua: "+x.group(2).trim(),false);else add(P,1,"Синтаксис Lua: "+m,false);}
      catch(Throwable t){}}
    Collections.sort(P,(a,b)->a.line-b.line);return P;}
  String readAsset(String n)throws IOException{InputStream in=getAssets().open(n);ByteArrayOutputStream bo=new ByteArrayOutputStream();byte[] b=new byte[4096];int c;while((c=in.read(b))>0)bo.write(b,0,c);in.close();return bo.toString("UTF-8");}
  static String ruErr(String m){m=String.valueOf(m).replaceAll("script:(\\d+):?\\s*","строка $1: ");
    if(m.contains("attempt to index"))m+="  (обращение к полю у пустого значения nil)";
    else if(m.contains("attempt to call"))m+="  (вызов того, что не является функцией; возможно, опечатка в имени)";
    else if(m.contains("attempt to perform arithmetic"))m+="  (математика с пустым или неподходящим значением)";
    else if(m.contains("attempt to compare"))m+="  (сравнение разных типов значений)";return m;}
