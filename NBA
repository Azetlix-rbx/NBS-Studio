  // ---------- лексер, подсветка, проверка ----------
  ArrayList<Tk> lex(String src){ArrayList<Tk> out=new ArrayList<>();Matcher m=LX.matcher(src);int line=1,last=0;
    while(m.find()){for(int i=last;i<m.start();i++)if(src.charAt(i)=='\n')line++;Tk k=new Tk();k.v=m.group();k.s=m.start();k.e=m.end();k.line=line;
      k.t=(m.group(1)!=null||m.group(3)!=null)?'c':(m.group(4)!=null||m.group(6)!=null||m.group(7)!=null)?'s':m.group(8)!=null?'n':m.group(9)!=null?'i':'o';
      if((m.group(6)!=null||m.group(7)!=null)&&(k.v.length()<2||k.v.charAt(k.v.length()-1)!=k.v.charAt(0)))k.bad=true;
      for(int i=0;i<k.v.length();i++)if(k.v.charAt(i)=='\n')line++;last=m.end();out.add(k);}
    return out;}
  int color(ArrayList<Tk> t,int j){Tk k=t.get(j);if(k.bad)return 0xFFFF8A8A;if(k.t=='c')return 0xFF6F7D6F;if(k.t=='s')return 0xFFADF195;if(k.t=='n')return 0xFFFFC600;if(k.t!='i')return 0;
    boolean mem=j>0&&(t.get(j-1).v.equals(".")||t.get(j-1).v.equals(":")),call=j+1<t.size()&&t.get(j+1).v.equals("(");
    if(mem)return call?0xFFFDFBAC:0xFFC3D1FF;if(k.v.equals("nil")||k.v.equals("true")||k.v.equals("false"))return 0xFFFFC600;
    if(KW.contains(k.v))return 0xFFF86D7C;if(BI.contains(k.v))return 0xFF84D6F7;return call?0xFFFDFBAC:0;}
