  void act(String id){hidePop();ClipboardManager cm=(ClipboardManager)getSystemService(Context.CLIPBOARD_SERVICE);
    switch(id){
      case "run":runSim();break;
      case "new":et.setText("");toast("Пустой скрипт");break;
      case "paste":{ClipData c=cm.getPrimaryClip();if(c!=null&&c.getItemCount()>0)ins(norm(c.getItemAt(0).coerceToText(this).toString()));break;}
      case "copy":cm.setPrimaryClip(ClipData.newPlainText("script",et.getText().toString()));toast("Скопировано");break;
      case "snip":{ArrayList<Ent> sn=new ArrayList<>();ArrayList<String> nm=new ArrayList<>();for(Ent e:ents)if(e.k=='s'){sn.add(e);nm.add(e.n+"   "+e.d);}
        new AlertDialog.Builder(this).setTitle("Шаблоны").setItems(nm.toArray(new String[0]),(d,i)->{int p=et.getSelectionStart();apply(sn.get(i),p,p);}).show();break;}
      case "data":dataDlg();break;
      case "file":new AlertDialog.Builder(this).setItems(new String[]{"Сохранить как .lua","Открыть файл"},(d,i)->{
          Intent n=new Intent(i==0?Intent.ACTION_CREATE_DOCUMENT:Intent.ACTION_OPEN_DOCUMENT).addCategory(Intent.CATEGORY_OPENABLE).setType("*/*");
          if(i==0)n.putExtra(Intent.EXTRA_TITLE,"script.lua");startActivityForResult(n,i);}).show();break;
