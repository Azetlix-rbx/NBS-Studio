  static String badOp(String v){switch(v){case "!=":return "В Lua «не равно» пишется ~=";case "&&":return "В Lua вместо && пишется and";case "||":return "В Lua вместо || пишется or";
    case "+=":case "-=":case "*=":case "/=":return "В Lua нет "+v+", пиши x = x + 1";case "++":return "В Lua нет ++, пиши x = x + 1";}return null;}
  void add(ArrayList<Pr> P,int l,String m,boolean w){Pr p=new Pr();p.line=l;p.msg=m;p.warn=w;P.add(p);}
  ArrayList<Pr> lint(ArrayList<Tk> t){ArrayList<Pr> P=new ArrayList<>();ArrayList<Tk> st=new ArrayList<>(),br=new ArrayList<>();
    for(int j=0;j<t.size();j++){Tk k=t.get(j);String v=k.v;if(k.bad)add(P,k.line,"Строка не закрыта: не хватает кавычки",false);
      if(k.t=='o'){String m=badOp(v);
        if(m!=null)add(P,k.line,m,false);
        else if(v.equals("(")||v.equals("[")||v.equals("{"))br.add(k);
        else if(v.equals(")")||v.equals("]")||v.equals("}")){if(br.isEmpty())add(P,k.line,"Лишняя закрывающая скобка "+v,false);
          else{Tk o=br.remove(br.size()-1);if(!o.v.equals(v.equals(")")?"(":v.equals("]")?"[":"{"))add(P,k.line,"Скобка "+o.v+" из строки "+o.line+" закрыта как "+v,false);}}}
      else if(k.t=='i'&&!(j>0&&(t.get(j-1).v.equals(".")||t.get(j-1).v.equals(":")))){
        switch(v){
          case "function":case "if":case "repeat":st.add(k);break;
          case "for":case "while":st.add(k);break;
          case "do":{Tk s=st.isEmpty()?null:st.get(st.size()-1);if(s!=null&&(s.v.equals("for")||s.v.equals("while"))&&!s.d)s.d=true;else st.add(k);break;}
          case "end":{if(st.isEmpty())add(P,k.line,"Лишний end: закрывать нечего",false);else{Tk s=st.remove(st.size()-1);if(s.v.equals("repeat"))add(P,k.line,"repeat из строки "+s.line+" закрывается через until, а не end",false);}break;}
          case "until":{if(!st.isEmpty()&&st.get(st.size()-1).v.equals("repeat"))st.remove(st.size()-1);else add(P,k.line,"until без repeat",false);break;}
          case "null":case "NULL":add(P,k.line,"В Lua пустое значение называется nil",true);break;}}}
    for(Tk k:st)add(P,k.line,"Не закрыт "+k.v+": не хватает "+(k.v.equals("repeat")?"until":"end"),false);
    for(Tk k:br)add(P,k.line,"Не закрыта скобка "+k.v,false);
    Collections.sort(P,(a,b)->a.line-b.line);return P;}

  // ---------- подсказки над строкой ----------
  void hidePop(){if(pop!=null&&pop.isShowing())pop.dismiss();}
  void ac(){int p=et.getSelectionStart();if(p<0||p!=et.getSelectionEnd()){hidePop();return;}
    String v=et.getText().toString();int i=p;while(i>0&&(Character.isLetterOrDigit(v.charAt(i-1))||v.charAt(i-1)=='_'))i--;
    word=v.substring(i,p);boolean dot=i>0&&(v.charAt(i-1)=='.'||v.charAt(i-1)==':');
    if((word.isEmpty()&&!dot)||(!word.isEmpty()&&Character.isDigit(word.charAt(0)))){hidePop();return;}
    final String q=word.toLowerCase();ArrayList<Ent> r=new ArrayList<>();
    for(Ent e:ents){if(dot&&e.k!='m'&&e.k!='f')continue;float ms=0;
      if(!q.isEmpty()){if(!e.h.contains(q))continue;int j=e.nl.indexOf(q);ms=j==0?0:j>0?1+j/100f:2;}e.sc=ms*10+e.p;r.add(e);}
    Collections.sort(r,(a,b)->a.sc!=b.sc?Float.compare(a.sc,b.sc):a.n.length()!=b.n.length()?a.n.length()-b.n.length():a.n.compareTo(b.n));
    if(r.size()>40)r=new ArrayList<>(r.subList(0,40));
    if(r.isEmpty()||(r.size()==1&&r.get(0).n.equals(word))){hidePop();return;}
    final int ws=i,pe=p;popRows.removeAllViews();
    for(Ent e:r){LinearLayout row=new LinearLayout(this);row.setGravity(Gravity.CENTER_VERTICAL);row.setMinimumHeight(dp(42));row.setPadding(dp(10),dp(4),dp(10),dp(4));row.setBackground(ripple(0,dp(8)));
      TextView a=new TextView(this);SpannableString ss=new SpannableString(e.n);int j=q.isEmpty()?-1:e.nl.indexOf(q);
      if(j>=0){ss.setSpan(new ForegroundColorSpan(AC),j,j+q.length(),0);ss.setSpan(new StyleSpan(Typeface.BOLD),j,j+q.length(),0);}
      a.setText(ss);a.setTextColor(TX);a.setTypeface(Typeface.MONOSPACE);a.setTextSize(14);
      TextView d=new TextView(this);d.setText(e.d);d.setTextColor(kc(e.k));d.setTextSize(12);d.setPadding(dp(14),dp(2),0,0);d.setSingleLine(true);d.setMaxWidth(dp(190));d.setEllipsize(TextUtils.TruncateAt.END);
      row.addView(a);row.addView(d);row.setOnClickListener(x->apply(e,ws,pe));popRows.addView(row);}
    popRows.measure(View.MeasureSpec.UNSPECIFIED,View.MeasureSpec.UNSPECIFIED);
    int sw=getResources().getDisplayMetrics().widthPixels,w=Math.min(popRows.getMeasuredWidth()+dp(4),sw-dp(8)),h=Math.min(popRows.getMeasuredHeight()+dp(2),dp(220));
    Layout L=et.getLayout();if(L==null)return;int ln=L.getLineForOffset(ws);int[] loc=new int[2],bl=new int[2];et.getLocationInWindow(loc);bar.getLocationInWindow(bl);
    int x=loc[0]+et.getCompoundPaddingLeft()+(int)L.getPrimaryHorizontal(ws)-et.getScrollX();
    int top=loc[1]+et.getExtendedPaddingTop()+L.getLineTop(ln),bot=loc[1]+et.getExtendedPaddingTop()+L.getLineBottom(ln);
    int y=top-h-dp(4);if(y<bl[1]+bar.getHeight())y=bot+dp(4);x=Math.max(dp(4),Math.min(x,sw-w-dp(4)));
    if(pop.isShowing())pop.update(x,y,w,h);else{pop.setWidth(w);pop.setHeight(h);pop.showAtLocation(et,Gravity.NO_GRAVITY,x,y);}}
  void apply(Ent e,int s,int p){Editable ed=et.getText();String v=ed.toString();String t=e.n;int off=-1;
    if(e.k=='s'){int ls=v.lastIndexOf('\n',s-1)+1,j=ls;while(j<v.length()&&v.charAt(j)==' ')j++;t=e.tpl.replace("\n","\n"+v.substring(ls,j));off=t.indexOf("$0");t=t.replace("$0","");}
    else if(e.ins!=null&&!(p<v.length()&&v.charAt(p)=='(')){t=e.ins;off=e.off;}
    quiet=true;ed.replace(s,p,t);quiet=false;et.requestFocus();et.setSelection(s+(off>=0?off:t.length()));hidePop();}
  void ins(String s){int a=Math.min(et.getSelectionStart(),et.getSelectionEnd()),z=Math.max(et.getSelectionStart(),et.getSelectionEnd());et.getText().replace(a,z,s);}
  void goTo(int l){String s=et.getText().toString();int p=0;for(int i=1;i<l;i++){int q=s.indexOf('\n',p);if(q<0)break;p=q+1;}et.requestFocus();et.setSelection(p);}

